# ── MARLEY Configuration ─────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# Required: Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Server port (default: 7777)
PORT=7777

# Optional: TTS voice (edge-tts, free, no API key needed)
# Run: edge-tts --list-voices  to see all options
# EDGE_TTS_VOICE=en-GB-RyanNeural

# Optional: Canvas LMS settings
# CANVAS_DAYS_AHEAD=14
# TIMEZONE=America/New_York
